<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.client.controller.CreateResourceController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>

        <Label text="Create Resource"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="5">
            <children>
                <Label text="Group:"/>
                <Label fx:id="groupLabel" text=""/>
            </children>
        </HBox>

        <Label text="Title:"/>
        <TextField fx:id="titleField" promptText="Enter title"/>

        <Label text="Type:"/>
        <TextField fx:id="typeField" promptText="document, link, pdf, video, ..."/>

        <Label text="Path / URL:"/>
        <TextField fx:id="urlField" promptText="https://... or local/path/to/file"/>

        <HBox spacing="10">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancel" onAction="#onCancelClick"/>
                <Button text="Create" onAction="#onCreateClick"/>
            </children>
        </HBox>

        <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;"/>

    </children>
</VBox>

