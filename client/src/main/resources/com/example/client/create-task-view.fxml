<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.client.CreateTaskController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>
        <Label text="Create Task"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="5">
            <children>
                <Label text="Group:"/>
                <Label fx:id="groupLabel" text=""/>
            </children>
        </HBox>

        <Label text="Title:"/>
        <TextField fx:id="titleField" promptText="Enter task title"/>

        <Label text="Description:"/>
        <TextArea fx:id="descriptionField"
                  promptText="Enter description"
                  prefRowCount="3"/>

        <Label text="Status:"/>
        <ComboBox fx:id="statusComboBox" prefWidth="200"/>

        <Label text="Deadline (optional, ISO, e.g. 2025-01-20T23:59:59):"/>
        <TextField fx:id="deadlineField" promptText="2025-01-20T23:59:59"/>

        <HBox spacing="10">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancel" onAction="#onCancelClick"/>
                <Button text="Create" onAction="#onCreateClick"/>
            </children>
        </HBox>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-text-fill: red;"/>
    </children>
</VBox>

