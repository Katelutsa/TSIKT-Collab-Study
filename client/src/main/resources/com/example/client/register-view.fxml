<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.client.controller.RegisterController"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label text="Collab Study - Register"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Name:"/>
        <TextField fx:id="nameField" promptText="Your full name"/>

        <Label text="Email:"/>
        <TextField fx:id="emailField" promptText="email@example.com"/>

        <Label text="Password:"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>

        <Label text="Confirm password:"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeat password"/>

        <HBox spacing="10">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancel" onAction="#onCancelClick"/>
                <Button text="Register" onAction="#onRegisterClick"/>
            </children>
        </HBox>

        <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;"/>

    </children>
</VBox>

