<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.client.controller.ResourcesController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>

        <HBox spacing="10">
            <children>
                <Label text="Resources"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Label text="Group:"/>
                <ComboBox fx:id="groupComboBox" prefWidth="200"/>

                <Button text="Reload groups" onAction="#onReloadGroupsClick"/>
                <Button text="Load resources" onAction="#onLoadResourcesClick"/>
                <Button text="Create Resource" onAction="#onCreateResourceClick"/>
                <Button text="Edit Resource" onAction="#onEditResourceClick"/>
                <Button text="Delete Resource" onAction="#onDeleteResourceClick"/>

                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <TableView fx:id="resourcesTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
                <TableColumn fx:id="urlColumn" text="Path / URL" prefWidth="300"/>
                <TableColumn fx:id="uploadedAtColumn" text="Uploaded at" prefWidth="180"/>
            </columns>
        </TableView>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>

    </children>
</VBox>
