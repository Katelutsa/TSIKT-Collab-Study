<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.client.controller.AnalyticsController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>
        <HBox spacing="10">
            <children>
                <Label text="Activity / Analytics"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="From:"/>
                <DatePicker fx:id="fromDatePicker"/>

                <Label text="To:"/>
                <DatePicker fx:id="toDatePicker"/>

                <Button text="Load All"
                        onAction="#onLoadAllClick"/>

                <Button text="Load Range"
                        onAction="#onLoadRangeClick"/>
            </children>
        </HBox>

        <TableView fx:id="activityTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="timeColumn" text="Time" prefWidth="180"/>
                <TableColumn fx:id="actionColumn" text="Action" prefWidth="160"/>
                <TableColumn fx:id="detailsColumn" text="Details" prefWidth="400"/>
            </columns>
        </TableView>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>

    </children>
</VBox>

